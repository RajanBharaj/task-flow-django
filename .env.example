# .env.example
# Copy this file to ".env" and fill in your own values.

# Get a free Postgres connection string from Render, Neon, or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/taskflow"

# Generate your own secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="replace-this-with-a-real-secret-key"

# Set to False in production
DEBUG=True
